# Backend Environment Variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resumedb
POSTGRES_HOST=db
POSTGRES_PORT=5434

QDRANT_HOST=qdrant
QDRANT_PORT=6334

# LLM Configuration
# Use 'groq' for development, 'openai' for production
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Environment Variables
NEXT_PUBLIC_BASE_PATH=/resume_generator
NEXT_PUBLIC_API_URL=https://brollysolutions.in/resume_generator
CORS_ALLOWED_ORIGINS=http://localhost:3004,https://brollysolutions.in
