FROM python:3.11-slim

WORKDIR /app

# WeasyPrint runtime libs — same as prod
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libcairo2 \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libgdk-pixbuf-2.0-0 \
        libffi8 \
        fonts-liberation \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --default-timeout=1000 --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch && \
    pip install --default-timeout=1000 --no-cache-dir -r requirements.txt && \
    python -m spacy download en_core_web_sm

# Source is volume-mounted at runtime — no COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "app", "--timeout-keep-alive", "75"]
